{
  "name": "dsh-runtime-kit",
  "version": "0.3.3",
  "description": "DSH runtime plugin: context governance, fast path, PTC orchestration, sandbox isolation and audit — zero business dependencies",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "context-governance",
    "fast-path",
    "ptc",
    "sandbox",
    "audit"
  ],
  "author": "daoyan2142",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoyan2142/dsh-runtime-kit.git"
  },
  "homepage": "https://github.com/daoyan2142/dsh-runtime-kit#readme",
  "bugs": {
    "url": "https://github.com/daoyan2142/dsh-runtime-kit/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:smoke": "node test/smoke.mjs",
    "test:governance": "node test/governance.mjs",
    "test:dashboard": "node test/dashboard.mjs",
    "test:manifest": "node test/manifest.mjs",
    "prepublishOnly": "npm run test:manifest && npm run test:smoke && npm run test:governance && npm run test:dashboard",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "files": [
    "dist",
    "docs",
    "patch.yml",
    "config.schema.json",
    "test",
    "client.js",
    "LICENSE"
  ],
  "dsh": {
    "plugin": {
      "entry": "dist/index.js",
      "services": ["runtimeKit"],
      "tools": [],
      "configSchema": "config.schema.json"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    },
    "bundle": {
      "patch": "./patch.yml",
      "rows": [
        {
          "rowId": "runtime-kit",
          "moduleName": "dsh-runtime-kit",
          "entryId": "include:runtime-kit"
        }
      ],
      "removable": true
    },
    "manifestVersion": 1
  },
  "publishConfig": {
    "access": "public"
  }
}




